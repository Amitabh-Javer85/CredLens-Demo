# Backend process settings. Python does not load this file automatically.
# Supply values as process environment variables for a local Python run.

# Optional: JSON list of allowed browser origins. Set locally; default is localhost:8000 and 127.0.0.1:8000.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Required for the API/worker job path; optional for scripts/demo_memo.py. Get the URL from your own Redis instance; docker-compose.yml provides one internally.
REDIS_URL=redis://localhost:6379/0
# Optional: Anthropic API key for live Claude memos. Get it from Anthropic Console > API Keys. Blank selects the canned memo.
ANTHROPIC_API_KEY=
# Optional: model ID for live Claude memos. Get an available ID from Anthropic documentation > Models overview > Model names. Blank selects the canned memo.
CLAUDE_MODEL=
