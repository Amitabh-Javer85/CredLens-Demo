# Root Docker Compose interpolation. Copy this file to .env in the project root.
# All settings are optional for the synthetic, canned-memo demo.

# Optional: Anthropic API key for live Claude memos. Get it from Anthropic Console > API Keys.
# Leave blank to use the canned memo; replace with your key only for local live testing.
ANTHROPIC_API_KEY=

# Optional: model ID for live Claude memos. Get an available ID from Anthropic documentation > Models overview > Model names.
# Both CLAUDE_MODEL and ANTHROPIC_API_KEY must be set for a live request.
CLAUDE_MODEL=
